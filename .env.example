NEXT_PUBLIC_SITE_URL=https://vznprints.com
# Optional; leave blank to keep Google Analytics disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public verification token retained from the existing vznprints.com site.
GOOGLE_SITE_VERIFICATION=z-kAzAls2KI-P7llglc3KenonXFLzT5EIDLPMzPeHrQ
TURNSTILE_SECRET_KEY=
# SMTP.com HTTP API for both forms. The key is not an SMTP password.
SMTP_API=
SMTP_CHANNEL=
CONTACT_FROM_EMAIL=contactforms@citryn.com
# Optional direct SMTP transport when the API/channel fields are blank.
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS (587); true = TLS from connection start (465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL="VZN Prints Website <website@vznprints.com>"
CONTACT_TO_EMAIL=contact@vznprints.com
# Optional Resend transport when the API/channel fields and SMTP_HOST are blank.
RESEND_API_KEY=
RESEND_FROM_EMAIL="VZN Prints Website <website@vznprints.com>"
