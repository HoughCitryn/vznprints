NEXT_PUBLIC_SITE_URL=https://vznprints.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
GOOGLE_SITE_VERIFICATION=
TURNSTILE_SECRET_KEY=
# SMTP is used for both forms when SMTP_HOST is set. Keep credentials server-only.
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS (587); true = TLS from connection start (465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL="VZN Prints Website <website@vznprints.com>"
CONTACT_TO_EMAIL=contact@vznprints.com
# Optional alternative: used only when SMTP_HOST is empty.
RESEND_API_KEY=
RESEND_FROM_EMAIL="VZN Prints Website <website@vznprints.com>"
